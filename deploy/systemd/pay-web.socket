[Unit]
Description=pay-invoicing web socket (Apache connects here; systemd hands it to gunicorn)

[Socket]
# systemd creates the socket and passes it to pay-web.service (LISTEN_FDS). gunicorn uses the inherited
# socket as it is: it never binds, chowns, chmods or removes it. Bound by gunicorn itself, the socket
# took the process's group (payinv) and Apache was refused.
ListenStream=/run/pay-invoicing-web/gunicorn.sock
SocketUser=payinv
SocketGroup=www-data
# Connecting to a Unix socket needs write permission on it (unix(7)): only payinv and group www-data.
SocketMode=0660
# systemd creates /run/pay-invoicing-web as root and cannot give it a group, so the directory must be
# open for Apache (www-data) to traverse; the socket's own mode above is the gate for every other account.
DirectoryMode=0755

[Install]
WantedBy=sockets.target
