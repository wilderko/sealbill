# Copy to /etc/sealbill/env (0640 root:payinv). Placeholders only; real values never go in git.
# systemd reads this file as is: no quotes, no `export`, no shell expansion.
# The cron jobs ALSO source it with bash (set -a; . file), so every value must be shell-safe:
# avoid `$`, backticks, spaces, quotes and `#` in passwords and keys (generate with token_urlsafe).
# The backup scripts split DATABASE_URL themselves (deploy/backup/pgenv.sh): a password in it goes
# to a private PGPASSFILE, never to a command line.
SECRET_KEY=change-me
ALLOWED_HOSTS=pay.example.org
# Peer authentication over the Unix socket: no password anywhere (README, step 2). Over TCP:
# DATABASE_URL=postgres://payinv:change-me@127.0.0.1:5432/payinv
DATABASE_URL=postgres:///payinv?host=/var/run/postgresql
SITE_URL=https://pay.example.org
# Where the Django admin lives: 24+ characters, trailing slash, not a client route. Required in production.
DJANGO_ADMIN_PATH=change-me-to-a-long-random-path/
# The secret Apache sends in X-Pay-Proxy-Secret, the same value as in
# /etc/apache2/pay-invoicing-proxy-secret.conf (README, step 4; generate it with token_urlsafe).
# Every request without it is refused with 403. Empty turns the check off: only where no other
# account can reach the app.
PROXY_SECRET=change-me
# Also set by the units; kept here so the backup cron and manage.py by hand agree.
VAULT_KEY_PATH=/run/pay-invoicing/vault.key
GPG_TMP_DIR=/run/pay-invoicing/gpg
MEDIA_ROOT=/srv/sealbill/media
# collectstatic writes here at every start of pay-web (tmpfs; the units are read-only elsewhere).
STATIC_ROOT=/run/pay-invoicing/static
VAULT_CONFIG_PATH=/srv/sealbill/vault/vault.json
DEFAULT_FROM_EMAIL=invoices@example.org
STAFF_NOTIFY_EMAILS=ops@example.org
# One payment reminder to the client this many days after an invoice was sent and is unpaid; 0 turns it off.
INVOICE_REMINDER_DAYS=30
EMAIL_HOST=localhost
EMAIL_PORT=25
# Addresses a webhook may never reach, comma separated (single addresses only: anything else stops the start):
# this host's own public addresses, so a webhook cannot reach what Apache restricts with `Require local`.
# A receiver that lives on that address too is named by its URL prefix in WEBHOOK_ALLOW_URL_PREFIXES
# (https, ending in "/"; other paths on that host stay refused). Here: WEBHOOK_DENY_ADDRESSES=203.0.113.10 and
# WEBHOOK_ALLOW_URL_PREFIXES=https://shop.example.com/payments/webhook/invoicing/
WEBHOOK_DENY_ADDRESSES=
WEBHOOK_ALLOW_URL_PREFIXES=
# Optional: see .env.example for the chain watchers, FX source and webhook switches.
EVM_RPC_URLS={}
TRONGRID_API_KEY=
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com
TON_ENABLED=false
# Language of the note on imported (Zaprite / Request Finance) payments: en (default) or sk
MIGRATION_NOTE_LANGUAGE=en
