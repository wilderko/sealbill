#: templates/portal/_quote.html:16
#, python-format
msgid ""
"Send exactly this amount of %(asset)s on %(network_name)s. Another token or "
"network cannot be matched automatically."
msgstr ""
"Envoyez exactement ce montant en %(asset)s sur %(network_name)s. Un autre "
"jeton ou un autre réseau ne peut pas être rapproché automatiquement."

#: templates/portal/_quote.html:17
msgid "Valid until"
msgstr "Valable jusqu'à"

#: templates/portal/_quote.html:17
msgid "This amount has expired. Get a new one."
msgstr "Ce montant a expiré. Demandez-en un nouveau."

#: templates/portal/_quote.html:21
msgid "Get a new amount"
msgstr "Obtenir un nouveau montant"

