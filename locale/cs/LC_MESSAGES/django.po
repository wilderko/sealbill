#: templates/portal/_quote.html:3
#, python-format
msgid "Pay %(asset)s on %(network_name)s"
msgstr "Platba v %(asset)s na %(network_name)s"

#: templates/portal/_quote.html:4
msgid "Amount to send"
msgstr "Částka k odeslání"

#: templates/portal/_quote.html:6 templates/portal/_quote.html:9
#: templates/portal/_quote.html:12
