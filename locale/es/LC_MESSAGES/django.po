#: apps/notify/services.py:37
#, python-format
msgid "New encryption key for your e-mail from %(org)s"
msgstr "Nueva clave de cifrado para su correo de %(org)s"

#: templates/email/key_replacement.html:4 templates/email/key_replacement.txt:3
#, python-format
msgid "Someone uploaded a new encryption key for your e-mail address. Once it is confirmed, %(org)s will encrypt its e-mails to you with that key instead of your current one, the key this message is encrypted to."
msgstr "Alguien ha subido una nueva clave de cifrado para su dirección de correo. Una vez confirmada, %(org)s cifrará los correos que le envíe con esa clave en lugar de con la actual, la clave con la que está cifrado este mensaje."

#: templates/email/key_replacement.html:4 templates/email/key_replacement.txt:5
#, python-format
msgid "Fingerprint of the new key: %(fingerprint)s"
msgstr "Huella digital de la nueva clave: %(fingerprint)s"

#: templates/email/key_replacement.html:4 templates/email/key_replacement.txt:7
msgid "If you uploaded it yourself, there is nothing to do here."
msgstr "Si la ha subido usted, no tiene que hacer nada."

#: templates/email/key_replacement.html:4 templates/email/key_replacement.txt:9
msgid "If you did not, open this link and cancel the new key there. It is refused, and your current key stays in use:"
msgstr "Si no, abra este enlace y cancele allí la nueva clave. Se rechazará y su clave actual se seguirá usando:"

#: templates/email/key_replacement.html:4 templates/email/key_replacement.txt:12
msgid "The link works for 7 days."
msgstr "El enlace es válido durante 7 días."

#: templates/keys/cancel.html:2 templates/keys/cancel.html:4
msgid "Cancel the new encryption key"
msgstr "Cancelar la nueva clave de cifrado"

#: templates/keys/cancel.html:7
msgid "Someone uploaded this key for your e-mail address. If it was not you, cancel it here: it is refused, and our e-mails to you stay encrypted to your current key."
msgstr "Alguien ha subido esta clave para su dirección de correo. Si no ha sido usted, cancélela aquí: se rechazará y nuestros correos le seguirán llegando cifrados con su clave actual."

#: templates/keys/cancel.html:9
msgid "Cancel the new key"
msgstr "Cancelar la nueva clave"

#: templates/keys/cancel.html:11
msgid "If you uploaded this key yourself, close this page: nothing changes."
msgstr "Si ha subido esta clave usted mismo, cierre esta página: no cambia nada."

#: templates/keys/cancelled.html:2 templates/keys/cancelled.html:4
msgid "The new key was cancelled"
msgstr "La nueva clave se ha cancelado"

#: templates/keys/cancelled.html:5
msgid "The new key was refused and will not be used."
msgstr "La nueva clave se ha rechazado y no se usará."

#: templates/keys/cancelled.html:5
msgid "Our e-mails to you stay encrypted to your current key."
msgstr "Nuestros correos le seguirán llegando cifrados con su clave actual."

#: templates/keys/cancel_unusable.html:5
msgid "This link has expired. If a key you did not upload is in use, write to us and we will remove it."
msgstr "Este enlace ha caducado. Si se está usando una clave que usted no ha subido, escríbanos y la eliminaremos."

#: templates/keys/cancel_unusable.html:6
msgid "This link has already been used: the new key was cancelled."
msgstr "Este enlace ya se ha usado: la nueva clave se ha cancelado."

#: templates/keys/cancel_refused.html:2 templates/keys/cancel_refused.html:4
msgid "The new key could not be cancelled"
msgstr "No se ha podido cancelar la nueva clave"

#: templates/keys/cancel_refused.html:5
msgid "Your previous key can no longer be used, so cancelling the new key would leave our e-mails to you unencrypted. The new key stays in use for now, and our staff have been told. Please write to us."
msgstr "Su clave anterior ya no se puede usar, así que cancelar la nueva clave dejaría sin cifrar los correos que le enviamos. Por ahora la nueva clave sigue en uso y nuestro personal ya está avisado. Escríbanos, por favor."

