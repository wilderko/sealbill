#: templates/portal/_quote.html:16
#, python-format
msgid ""
"Send exactly this amount of %(asset)s on %(network_name)s. Another token or "
"network cannot be matched automatically."
msgstr ""
"Envíe exactamente este importe en %(asset)s en %(network_name)s. Otro token "
"u otra red no puede asociarse automáticamente."

#: templates/portal/_quote.html:17
msgid "Valid until"
msgstr "Válido hasta"

#: templates/portal/_quote.html:17
msgid "This amount has expired. Get a new one."
msgstr "Este importe ha caducado. Solicite uno nuevo."

#: templates/portal/_quote.html:21
msgid "Get a new amount"
msgstr "Obtener un nuevo importe"

#: templates/portal/_quote.html:23
msgid ""
"After you have sent it, this page updates by itself. If it does not, use “I "
"have paid” below."
msgstr ""
"Cuando lo haya enviado, esta página se actualizará sola. Si no es así, use "
"abajo «He pagado»."

