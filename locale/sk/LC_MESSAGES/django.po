#: apps/core/tests_i18n.py:196 templates/vault/unlock.html:5
msgid "Unlock the vault"
msgstr "Odomknutie trezoru"

#: apps/keys/views.py:30
msgid "The file is too large to be a public key."
msgstr "Súbor je na verejný kľúč príliš veľký."

#: apps/keys/views.py:31
msgid ""
"This is a .p12/.pfx file, which holds a private key. Upload only the "
"certificate."
msgstr ""
"Toto je súbor .p12/.pfx, ktorý obsahuje súkromný kľúč. Nahrajte iba "
"certifikát."

#: apps/keys/views.py:32
msgid ""
"This contains a private key. Keep it to yourself and upload only the public "
"key."
msgstr ""
"Toto obsahuje súkromný kľúč. Nechajte si ho pre seba a nahrajte iba verejný "
"kľúč."

#: apps/keys/views.py:33
msgid "This is not a PGP public key or an S/MIME certificate."
msgstr "Toto nie je verejný kľúč PGP ani certifikát S/MIME."

#: apps/keys/views.py:34
msgid "This contains more than one key. Upload one key only."
msgstr "Toto obsahuje viac ako jeden kľúč. Nahrajte iba jeden."

#: apps/keys/views.py:35
msgid "This key cannot be used to encrypt e-mail."
msgstr "Týmto kľúčom sa nedajú šifrovať e-maily."

#: apps/keys/views.py:36
msgid "This key has expired."
msgstr "Platnosť tohto kľúča vypršala."

#: apps/keys/views.py:37
msgid "This key is not valid yet."
msgstr "Tento kľúč ešte nie je platný."

#: apps/keys/views.py:38
msgid "This key has been revoked."
msgstr "Tento kľúč bol odvolaný."

#: apps/keys/views.py:39
msgid "This key does not name the e-mail address we write to you at."
msgstr "Tento kľúč neuvádza e-mailovú adresu, na ktorú vám píšeme."

#: apps/keys/views.py:40
msgid "This type or size of key is not supported."
msgstr "Tento typ alebo veľkosť kľúča nepodporujeme."

#: apps/keys/views.py:75
msgid ""
"Too many keys were uploaded through this link. Please try again in an hour."
msgstr ""
"Cez tento odkaz bolo nahraných priveľa kľúčov. Skúste to znova o hodinu."

#: apps/keys/views.py:79
msgid "Paste the key or choose a file."
msgstr "Vložte kľúč alebo vyberte súbor."

#: apps/keys/views.py:87 apps/keys/views.py:140
msgid ""
"We could not check the key right now. Please try again in a few minutes."
msgstr "Kľúč sa teraz nepodarilo overiť. Skúste to znova o niekoľko minút."

#: apps/notify/services.py:32
#, python-format
msgid "Invoice %(ref)s from %(org)s"
msgstr "Faktúra %(ref)s od %(org)s"

#: apps/notify/services.py:33
#, python-format
msgid "Payment request %(ref)s from %(org)s"
msgstr "Žiadosť o platbu %(ref)s od %(org)s"

#: apps/notify/services.py:34
#, python-format
msgid "Receipt for %(ref)s from %(org)s"
msgstr "Potvrdenie o platbe k %(ref)s od %(org)s"

#: apps/notify/services.py:35
#, python-format
msgid "Partial payment received for %(ref)s"
msgstr "Prijatá čiastočná platba k %(ref)s"

#: apps/notify/services.py:36
#, python-format
msgid "Confirm your encryption key for %(org)s"
msgstr "Potvrďte svoj šifrovací kľúč pre %(org)s"

#: apps/notify/services.py:37
#, python-format
msgid "Payment declared for %(ref)s"
msgstr "Platba k %(ref)s bola oznámená"

#: apps/notify/services.py:38
#, python-format
msgid "The vault is sealed: %(count)s e-mails are waiting"
msgstr "Trezor je zapečatený: čaká %(count)s e-mailov"

#: apps/notify/services.py:39
#, python-format
msgid "Payment #%(ref)s needs review"
msgstr "Platba č. %(ref)s potrebuje kontrolu"

#: apps/notify/services.py:40
#, python-format
msgid "Payment #%(ref)s is waiting for your confirmation"
msgstr "Platba č. %(ref)s čaká na vaše potvrdenie"

#: apps/notify/services.py:44
#, python-format
msgid "Message from %(org)s"
msgstr "Správa od %(org)s"

#: apps/payments/models.py:36
msgid "The token is not one this invoice accepts."
msgstr "Tento token faktúra neprijíma."

#: apps/payments/models.py:37
msgid "No open invoice matches this payment."
msgstr "Žiadna otvorená faktúra tejto platbe nezodpovedá."

#: apps/payments/models.py:38
msgid "More than one open invoice could match this payment."
msgstr "Tejto platbe by mohla zodpovedať viac otvorených faktúr."

#: apps/payments/models.py:39
msgid "The payment arrived after the quote expired."
msgstr "Platba dorazila po vypršaní kurzovej ponuky."

#: apps/payments/models.py:40
msgid "This looks like a duplicate of another payment."
msgstr "Vyzerá to ako duplicita inej platby."

#: apps/payments/models.py:41
msgid "The payment is far above what was owed."
msgstr "Platba je výrazne vyššia, než bolo dlžné."

#: apps/payments/models.py:42
msgid "The invoice was already closed when the payment arrived."
msgstr "Faktúra bola v čase prijatia platby už uzavretá."

#: apps/payments/models.py:43
msgid "The payment was made before the quote was issued."
msgstr "Platba bola uskutočnená pred vystavením kurzovej ponuky."

#: apps/payments/models.py:44
msgid "A very small transfer, probably address-poisoning spam."
msgstr "Veľmi malý prevod, pravdepodobne spam typu address poisoning."

#: apps/payments/models.py:45
msgid "The transaction was dropped from the chain."
msgstr "Transakcia bola z reťazca vypadnutá."

#: apps/payments/models.py:46
msgid "BTCPay reports a partial payment."
msgstr "BTCPay hlási čiastočnú platbu."

#: apps/payments/models.py:47
msgid "BTCPay invoice was marked as paid by hand."
msgstr "Faktúra v BTCPay bola ručne označená ako zaplatená."

#: apps/payments/models.py:48
msgid "BTCPay reports the invoice as invalid."
msgstr "BTCPay hlási faktúru ako neplatnú."

#: apps/payments/models.py:49
msgid "BTCPay reports a late payment."
msgstr "BTCPay hlási neskoro prijatú platbu."

#: apps/portal/crypto.py:69
#, python-format
msgid "%(asset)s on %(network)s"
msgstr "%(asset)s na %(network)s"

#: apps/portal/forms.py:6
msgid "Network (optional)"
msgstr "Sieť (nepovinné)"

#: apps/portal/forms.py:7
msgid "Transaction number or hash (optional)"
msgstr "Číslo transakcie alebo hash (nepovinné)"

#: apps/portal/forms.py:8
msgid "Note (optional)"
msgstr "Poznámka (nepovinné)"

#: apps/portal/forms.py:13
msgid "Other"
msgstr "Iné"

#: apps/portal/views.py:181
msgid "This invoice can no longer be paid online."
msgstr "Túto faktúru už nie je možné zaplatiť online."

#: apps/portal/views.py:182
msgid "This payment method is not available for this invoice."
msgstr "Tento spôsob platby nie je pre túto faktúru dostupný."

#: apps/portal/views.py:183
msgid "That network or token is not available for this invoice."
msgstr "Táto sieť alebo tento token nie je pre túto faktúru dostupný."

#: apps/portal/views.py:184
msgid "Nothing is left to pay on this invoice."
msgstr "Na tejto faktúre už nie je čo platiť."

#: apps/portal/views.py:185
msgid "Exchange rates are unavailable right now. Try again in a minute."
msgstr "Výmenné kurzy sú momentálne nedostupné. Skúste to o minútu znova."

#: apps/portal/views.py:186
msgid ""
"The exchange rate cannot be fixed reliably right now. Try again in a minute."
msgstr ""
"Výmenný kurz sa momentálne nedá spoľahlivo určiť. Skúste to o minútu znova."

#: apps/portal/views.py:213
msgid ""
"Too many payments are open right now. Please try again in a few minutes."
msgstr ""
"Práve je otvorených príliš veľa platieb. Skúste to, prosím, znova o "
"niekoľko minút."

#: apps/portal/views.py
msgid "There have been too many payment attempts on this invoice today. Please try again tomorrow, or contact us."
msgstr "Na túto faktúru bolo dnes príliš veľa pokusov o platbu. Skúste to, prosím, znova zajtra alebo nás kontaktujte."

#: apps/portal/views.py:188
msgid ""
"This payment method is temporarily unavailable. Try another one, or try "
"again shortly."
msgstr ""
"Tento spôsob platby je dočasne nedostupný. Skúste iný alebo to o chvíľu "
"zopakujte."

#: apps/portal/views.py:214
msgid "Too many attempts. Wait a few minutes and try again."
msgstr "Príliš veľa pokusov. Počkajte niekoľko minút a skúste to znova."

#: apps/vault/views.py:17
msgid "Too many attempts. Try again later."
msgstr "Príliš veľa pokusov. Skúste to neskôr."

#: templates/email/declared_staff.html:4 templates/email/declared_staff.txt:1
#, python-format
msgid "A client has declared a payment for %(ref)s. It needs your review."
msgstr "Klient oznámil platbu k %(ref)s. Vyžaduje vašu kontrolu."

#: templates/email/declared_staff.html:4 templates/email/declared_staff.txt:7
msgid "Open the invoice on the staff page:"
msgstr "Otvorte faktúru na stránke pre zamestnancov:"

#: templates/email/invoice.html:4 templates/email/invoice.txt:1
#: templates/email/key_confirm.html:4 templates/email/key_confirm.txt:1
#: templates/email/partial.html:4 templates/email/partial.txt:1
#: templates/email/receipt.html:4 templates/email/receipt.txt:1
#, python-format
msgid "Dear %(name)s,"
msgstr "Dobrý deň, %(name)s,"

#: templates/email/invoice.html:4 templates/email/invoice.txt:3
#, python-format
msgid "%(org)s has sent you a payment request (%(ref)s)."
msgstr "%(org)s vám zaslala žiadosť o platbu (%(ref)s)."

#: templates/email/invoice.html:4 templates/email/invoice.txt:4
#, python-format
msgid "%(org)s has sent you invoice %(ref)s."
msgstr "%(org)s vám zaslala faktúru %(ref)s."

#: templates/email/invoice.html:4 templates/email/invoice.txt:8
#, python-format
msgid "Amount due: %(total)s"
msgstr "Suma na úhradu: %(total)s"

#: templates/email/invoice.html:4 templates/email/invoice.txt:10
#, python-format
msgid "Due date: %(due)s"
msgstr "Dátum splatnosti: %(due)s"

#: templates/email/invoice.html:4 templates/email/invoice.txt:12
msgid "Pay online:"
msgstr "Zaplatiť online:"

#: templates/email/invoice.html:4 templates/email/invoice.txt:15
msgid "View the invoice online:"
msgstr "Zobraziť faktúru online:"

#: templates/email/invoice.html:4 templates/email/invoice.txt:18
msgid "The payment request is attached as a PDF."
msgstr "Žiadosť o platbu je priložená ako PDF."

#: templates/email/invoice.html:4 templates/email/invoice.txt:18
msgid "The invoice is attached as a PDF."
msgstr "Faktúra je priložená ako PDF."

#: templates/email/invoice.html:4 templates/email/invoice.txt:19
#: templates/email/receipt.html:4 templates/email/receipt.txt:11
msgid ""
"The PDF could not be attached to this e-mail. You can download it from the "
"invoice page."
msgstr ""
"PDF sa nepodarilo priložiť k tomuto e-mailu. Môžete si ho stiahnuť zo "
"stránky faktúry."

#: templates/email/key_confirm.html:4 templates/email/key_confirm.txt:3
#, python-format
msgid ""
"A key was uploaded for your e-mail address so that %(org)s can send you "
"encrypted e-mail:"
msgstr ""
"Pre vašu e-mailovú adresu bol nahraný kľúč na šifrovanie e-mailov od %(org)s:"

#: templates/email/key_confirm.html:4 templates/email/key_confirm.txt:5
#, python-format
msgid "Fingerprint: %(fingerprint)s"
msgstr "Odtlačok: %(fingerprint)s"

#: templates/email/key_confirm.html:4 templates/email/key_confirm.txt:7
msgid "To start using it, open this link and press Confirm:"
msgstr "Ak ho chcete začať používať, otvorte tento odkaz a stlačte Potvrdiť:"

#: templates/email/key_confirm.html:4 templates/email/key_confirm.txt:10
msgid ""
"The link works for 7 days. Until you confirm, our e-mails to you stay as "
"they are."
msgstr ""
"Odkaz platí 7 dní. Kým kľúč nepotvrdíte, naše e-maily vám budú chodiť ako "
"doteraz."

#: templates/email/key_confirm.html:4 templates/email/key_confirm.txt:12
msgid "If you did not upload this key, ignore this e-mail: nothing changes."
msgstr ""
"Ak ste tento kľúč nenahrali vy, tento e-mail ignorujte. Nič sa nezmení."

#: templates/email/partial.html:4 templates/email/partial.txt:3
#, python-format
msgid "%(org)s has received a partial payment for %(ref)s."
msgstr "%(org)s prijala čiastočnú platbu k %(ref)s."

#: templates/email/partial.html:4 templates/email/partial.txt:5
#, python-format
msgid "Amount received: %(paid)s"
msgstr "Prijatá suma: %(paid)s"

#: templates/email/partial.html:4 templates/email/partial.txt:7
#, python-format
msgid "Still outstanding: %(remaining)s"
msgstr "Zostáva uhradiť: %(remaining)s"

#: templates/email/partial.html:4 templates/email/partial.txt:9
msgid "You can pay the rest here:"
msgstr "Zvyšok môžete zaplatiť tu:"

#: templates/email/partial.html:4 templates/email/partial.txt:10
msgid "To pay the rest, please use the payment link from our original e-mail."
msgstr "Zvyšok uhraďte prosím cez odkaz na platbu z nášho pôvodného e-mailu."

#: templates/email/receipt.html:4 templates/email/receipt.txt:3
#, python-format
msgid "Thank you. %(org)s has received your payment for %(ref)s."
msgstr "Ďakujeme. %(org)s prijala vašu platbu k %(ref)s."

#: templates/email/receipt.html:4 templates/email/receipt.txt:5
#, python-format
msgid "Amount paid: %(total)s"
msgstr "Zaplatená suma: %(total)s"

#: templates/email/receipt.html:4 templates/email/receipt.txt:7
msgid "View the receipt online:"
msgstr "Zobraziť potvrdenie online:"

#: templates/email/receipt.html:4 templates/email/receipt.txt:10
msgid "Your receipt is attached as a PDF."
msgstr "Potvrdenie o platbe je priložené ako PDF."

#: templates/email/vault_sealed_staff.html:4
#: templates/email/vault_sealed_staff.txt:1
#, python-format
msgid "The vault is sealed, so %(count)s e-mails cannot be sent."
msgstr "Trezor je zapečatený, preto sa nedá odoslať %(count)s e-mailov."

#: templates/email/vault_sealed_staff.html:4
#: templates/email/vault_sealed_staff.txt:3
msgid "Unlock it here:"
msgstr "Odomknite ho tu:"

#: templates/keys/confirm.html:2 templates/keys/confirm.html:4
msgid "Confirm your encryption key"
msgstr "Potvrďte svoj šifrovací kľúč"

#: templates/keys/confirm.html:5 templates/keys/confirmed.html:5
#: templates/keys/upload.html:7
msgid "Fingerprint"
msgstr "Odtlačok"

#: templates/keys/confirm.html:7
msgid ""
"Press Confirm and our e-mails to you will be encrypted to this key from now "
"on."
msgstr "Stlačte Potvrdiť a odteraz vám budeme e-maily šifrovať týmto kľúčom."

#: templates/keys/confirm.html:10
msgid "Confirm"
msgstr "Potvrdiť"

#: templates/keys/confirm.html:12
msgid "If you did not ask for this, close this page: nothing changes."
msgstr "Ak ste o to nežiadali, zatvorte túto stránku. Nič sa nezmení."

#: templates/keys/confirmed.html:2 templates/keys/confirmed.html:4
msgid "Key confirmed"
msgstr "Kľúč je potvrdený"

#: templates/keys/confirmed.html:7
msgid "From now on, our e-mails to you are encrypted to this key."
msgstr "Odteraz vám e-maily šifrujeme týmto kľúčom."

#: templates/keys/expired.html:2 templates/keys/expired.html:4
msgid "This key cannot be used"
msgstr "Tento kľúč sa nedá použiť"

#: templates/keys/expired.html:2 templates/keys/expired.html:4
msgid "This link does not work"
msgstr "Tento odkaz nefunguje"

#: templates/keys/expired.html:6
msgid "Upload a working key from your invoice page."
msgstr "Nahrajte funkčný kľúč na stránke faktúry."

#: templates/keys/expired.html:7
msgid ""
"This link has expired. Upload the key again from your invoice page and we "
"will send you a new one."
msgstr ""
"Platnosť tohto odkazu vypršala. Nahrajte kľúč znova na stránke faktúry a "
"pošleme vám nový."

#: templates/keys/expired.html:8
msgid "This link has already been used, or the key it confirms was withdrawn."
msgstr ""
"Tento odkaz už bol použitý alebo kľúč, ktorý potvrdzuje, bol zrušený."

#: templates/keys/expired.html:9
msgid "This link is not valid. Check that you copied all of it."
msgstr "Tento odkaz nie je platný. Skontrolujte, či ste ho skopírovali celý."

#: templates/keys/upload.html:2 templates/keys/upload.html:4
#: templates/portal/invoice.html:7
msgid "Receive encrypted e-mail"
msgstr "Dostávať šifrované e-maily"

#: templates/keys/upload.html:6
msgid "Check your e-mail"
msgstr "Skontrolujte si e-mail"

#: templates/keys/upload.html:9
msgid ""
"We sent a confirmation e-mail, encrypted to this key, to your address. Open "
"it and follow the link inside to start using the key. Until then nothing "
"changes. The link works for 7 days."
msgstr ""
"Na vašu adresu sme poslali potvrdzovací e-mail zašifrovaný týmto kľúčom. "
"Otvorte ho a kliknite na odkaz v ňom, aby sa kľúč začal používať. Dovtedy sa "
"nič nemení. Odkaz platí 7 dní."

#: templates/keys/upload.html:11
msgid ""
"Upload your PGP public key or S/MIME certificate. Our e-mails to you, "
"invoices and receipts included, will then be encrypted to it."
msgstr ""
"Nahrajte svoj verejný kľúč PGP alebo certifikát S/MIME. Naše e-maily vrátane "
"faktúr a potvrdení o platbe vám potom budeme šifrovať týmto kľúčom."

#: templates/keys/upload.html:12
msgid ""
"Upload only a public key or a certificate, never a private key or a .p12/."
"pfx file."
msgstr ""
"Nahrajte iba verejný kľúč alebo certifikát, nikdy nie súkromný kľúč ani "
"súbor .p12/.pfx."

#: templates/keys/upload.html:15
msgid "Paste the key"
msgstr "Vložte kľúč"

#: templates/keys/upload.html:17
msgid "Or choose a file"
msgstr "Alebo vyberte súbor"

#: templates/keys/upload.html:19
msgid "Upload the key"
msgstr "Nahrať kľúč"

#: templates/keys/upload.html:22
msgid "Back to the invoice"
msgstr "Späť na faktúru"

