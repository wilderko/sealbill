#: templates/pdf/invoice.html:2 templates/portal/_summary.html:4
#: templates/portal/invoice.html:2 templates/portal/pay.html:2
msgid "Invoice"
msgstr "Faktúra"

#: templates/pdf/invoice.html:4 templates/portal/pay.html:10
