# Copy to .env. Never commit .env.
SECRET_KEY=change-me
ALLOWED_HOSTS=pay.example.org
DATABASE_URL=postgres://pay:change-me@postgres:5432/pay
SITE_URL=https://pay.example.org
# Where the Django admin lives: 24+ characters, trailing slash, not a client route. Production refuses to
# start without it, and refuses this placeholder.
DJANGO_ADMIN_PATH=change-me-to-a-long-random-path/
DEFAULT_FROM_EMAIL=invoices@example.org
STAFF_NOTIFY_EMAILS=ops@example.org
VAULT_KEY_PATH=/run/vault/key
VAULT_CONFIG_PATH=/app/vault/vault.json
# The secret the reverse proxy sends in X-Pay-Proxy-Secret (README, Docker Compose); every request
# without it is refused with 403. Set it wherever another account on the host can reach port 8000.
# Empty turns the check off: `check --deploy` and `healthcheck` then say so.
PROXY_SECRET=
# Must be the password in DATABASE_URL above.
POSTGRES_PASSWORD=change-me
# JSON: per-network EVM RPC endpoints replacing the defaults, e.g. {"arbitrum": ["https://rpc.example/KEY"]}
EVM_RPC_URLS={}
# Chain watchers. Keys are optional; the free tiers are rate limited.
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=
# Comma separated, tried in order.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com
# TON stays off until the credit to our own jetton wallet can be verified (see README).
TON_ENABLED=false
TONCENTER_API_URL=https://toncenter.com/api/v3
TONCENTER_API_KEY=
# Exchange rates: Bitstamp and Coinbase are cross-checked (over 100 bps apart refuses a quote).
# Frankfurter (ECB) supplies the EUR to other-fiat leg, multiplied into both; it is not cross-checked.
FX_FRANKFURTER_URL=https://api.frankfurter.dev/v1
# Set to false to stop every outbound call of the crypto rails.
RAILS_HTTP_ENABLED=true
# Rail URLs must resolve to public addresses. An LND or CLN on this machine is reached only on this one
# port (loopback, plain http allowed there); unset, never.
# LOCAL_LIGHTNING_PORT=8080
# Outgoing webhooks: https to public addresses only. Set the two switches only for a development receiver.
WEBHOOK_HTTP_ENABLED=true
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE=false
# Comma separated: this host's own public addresses (production sets them); a webhook to one is refused.
WEBHOOK_DENY_ADDRESSES=
# Comma separated https URL prefixes (ending in "/") delivered to although they resolve to a denied address.
WEBHOOK_ALLOW_URL_PREFIXES=
